      "patch": "./dsh.bundle.patch"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "index.js",
    "client.js",
    "dsh.bundle.patch",
    "icon.png",
    "locale",
    "bin"
