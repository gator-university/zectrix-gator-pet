{
  "name": "zectrix-croc-pet",
  "version": "0.7.4",
  "private": true,
  "description": "鳄鱼大宠物：把 DeepSeek Harness 的会话状态推到 Zectrix Note 4 墨水屏。",
  "type": "module",
  "license": "MIT",
  "author": "gator-university",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
